# PaperGenerator — environment variables (root .env)
# Copy ke .env dan isi dengan nilai asli.
# JANGAN commit .env asli ke repository.

# === Database (WAJIB) ===
# PostgreSQL connection. Untuk peer auth Unix socket:
#   postgresql://papergenerator@/papergenerator
# Untuk TCP: postgresql://user:password@localhost:5432/papergenerator
DATABASE_URL=postgresql://papergenerator@/papergenerator

# === Redis (WAJIB) ===
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SOCKET_TTL=5

# === Security (WAJIB — generate random 64-char string) ===
SECRET_KEY=changeme-generate-random-64-chars
JWT_SECRET_KEY=changeme-generate-random-64-chars
JWT_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_DOMAIN=
SIGNED_URL_SECRET=changeme

# === Flask ===
FLASK_ENV=production
FLASK_DEBUG=false
PRODUCTION=true
CORS_ORIGINS=http://localhost:8000,http://localhost:1000
BACKEND_PORT=8001

# === Auth ===
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_ALLOWED_EMAILS=
FRONTEND_URL_ALLOWLIST=http://localhost:8000

# === Turnstile (Captcha) ===
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# === AI/Literatur API Keys ===
AIOTOMASI_API=https://api.aiotomassi.example.com
AIOTOMASI_APIKEY=changeme
CORE_API_KEY=changeme
ELSEVIER_API_KEY=changeme
NCBI_API_KEY=changeme
OPENALEX_API_KEY=
SPRINGER_API_KEY=
IEEE_API_KEY=
DIMENSIONS_API_KEY=
LENS_API_KEY=
LENS_TOKEN=
S2_API_KEY=
SEMANTIC_SCHOLAR_KEY=
NASA_ADS_TOKEN=

# === Contact ===
CONTACT_EMAIL=research@example.com
SLR_CONTACT_EMAIL=research@example.com
OPENALEX_EMAIL=research@example.com

# === Translation ===
DEEPL_API_KEY=changeme
LIBRE_TRANSLATE_URL=https://libretranslate.com
LIBRE_API_KEY=
LINGVANEX_API_KEY=

# === S3 Storage (opsional) ===
S3_ENABLED=false
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET_NAME=papergenerator-files
S3_REGION=us-east-1

# === Monitoring ===
GLITCHTIP_DSN=
SENTRY_RELEASE=dev
LOG_LEVEL=INFO
METRICS_ALLOWED_IPS=127.0.0.1,::1

# === AI / Retry ===
AI_RETRY_COUNT=5
AI_TIMEOUT_SECONDS=1800

# === Paper DB (literatur cache) ===
PAPER_DB_HOST=/var/run/postgresql
PAPER_DB_PORT=5432
PAPER_DB_NAME=paper_database
PAPER_DB_USER=sirobo
PAPER_DB_PASS=
PAPER_DB_DSN=dbname=paper_database host=/var/run/postgresql

# === Rate Limiting ===
RATELIMIT_STORAGE_URI=

# === Misc ===
QUERY_LOGGING_ENABLED=false
SLR_MAX_WORKERS=10
SINTA_OFFLINE_DIR=
IMAGE_GEN_WATCHDOG_TIMEOUT=600
IMAGE_GEN_GENERATE_TIMEOUT=300
IMAGE_GEN_MAX_RETRIES=3