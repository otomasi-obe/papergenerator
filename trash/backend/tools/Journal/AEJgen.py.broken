"""
AEJgen.py - Generator DOCX untuk jurnal AEJ.
Menggunakan dokumen asli AEJ.docx sebagai base template.
Data diambil dari _template.json.
Auto-generated by gen_factory.py.
"""
import json
import copy
import shutil
import re
import os
from pathlib import Path
from docx import Document
from docx.shared import Pt, Cm, Inches, Twips, RGBColor, Emu
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml.ns import qn, nsdecls
from docx.oxml import parse_xml, OxmlElement
from lxml import etree

BASE = Path(__file__).resolve().parent
TEMPLATE_DOCX = BASE / "AEJ.docx"
TEMPLATE_JSON = BASE / "_template.json"
OUTPUT_DOCX = BASE / "AEJ_output.docx"

CFG = {
    "font_body": "Calibri",
    "font_title": "Calibri",
    "font_heading": "Calibri",
    "size_body": 9,
    "size_title": 14,
    "size_heading1": 11,
    "size_heading2": 10,
    "size_caption": 8,
    "heading_color": (0x94, 0x36, 0x34),
    "size_reference": 8,
    "columns": 2,
    "first_line_indent_tw": 0,
    "table_borders": "full",
    "fig_prefix": "Fig.",
    "tbl_prefix": "Table",
    "section_heading_upper": True,
}

def load_json():
    with open(TEMPLATE_JSON, "r", encoding="utf-8") as f:
        return json.load(f)


def set_run_font(run, font_name=None, size_pt=None, bold=None, italic=None, color=None):
    if font_name:
        run.font.name = font_name
        rPr = run._element.get_or_add_rPr()
        rFonts = rPr.find(qn("w:rFonts"))
        if rFonts is None:
            rFonts = OxmlElement("w:rFonts")
            rPr.insert(0, rFonts)
        rFonts.set(qn("w:ascii"), font_name)
        rFonts.set(qn("w:hAnsi"), font_name)
        rFonts.set(qn("w:cs"), font_name)
    if size_pt:
        run.font.size = Pt(size_pt)
    if bold is not None:
        run.bold = bold
    if italic is not None:
        run.italic = italic
    if color:
        run.font.color.rgb = RGBColor(*color)


def set_para_spacing(para, before_pt=None, after_pt=None, line_tw=None):
    pf = para.paragraph_format
    if before_pt is not None:
        pf.space_before = Pt(before_pt)
    if after_pt is not None:
        pf.space_after = Pt(after_pt)
    if line_tw is not None:
        pPr = para._element.get_or_add_pPr()
        spacing = pPr.find(qn("w:spacing"))
        if spacing is None:
            spacing = OxmlElement("w:spacing")
            pPr.append(spacing)
        spacing.set(qn("w:line"), str(line_tw))
        spacing.set(qn("w:lineRule"), "auto")


def set_para_indent(para, first_line_tw=None, left_tw=None, hanging_tw=None):
    pPr = para._element.get_or_add_pPr()
    ind = pPr.find(qn("w:ind"))
    if ind is None:
        ind = OxmlElement("w:ind")
        pPr.append(ind)
    if first_line_tw is not None:
        ind.set(qn("w:firstLine"), str(first_line_tw))
    if left_tw is not None:
        ind.set(qn("w:left"), str(left_tw))
    if hanging_tw is not None:
        ind.set(qn("w:hanging"), str(hanging_tw))
        if ind.get(qn("w:firstLine")):
            del ind.attrib[qn("w:firstLine")]


def set_table_borders(table, style="three_line"):
    tblPr = table._element.find(qn("w:tblPr"))
    if tblPr is None:
        tblPr = OxmlElement("w:tblPr")
        table._element.insert(0, tblPr)
    borders = tblPr.find(qn("w:tblBorders"))
    if borders is not None:
        tblPr.remove(borders)
    borders = OxmlElement("w:tblBorders")

    if style == "three_line":
        for side in ("top", "bottom", "insideH"):
            el = OxmlElement(f"w:{side}")
            el.set(qn("w:val"), "single")
            el.set(qn("w:sz"), "4")
            el.set(qn("w:space"), "0")
            el.set(qn("w:color"), "000000")
            borders.append(el)
        for side in ("left", "right", "insideV"):
            el = OxmlElement(f"w:{side}")
            el.set(qn("w:val"), "none")
            el.set(qn("w:sz"), "0")
            el.set(qn("w:space"), "0")
            el.set(qn("w:color"), "auto")
            borders.append(el)
    elif style == "full":
        for side in ("top", "left", "bottom", "right", "insideH", "insideV"):
            el = OxmlElement(f"w:{side}")
            el.set(qn("w:val"), "single")
            el.set(qn("w:sz"), "4")
            el.set(qn("w:space"), "0")
            el.set(qn("w:color"), "000000")
            borders.append(el)
    elif style == "partial":
        for side in ("top", "bottom", "insideH", "insideV"):
            el = OxmlElement(f"w:{side}")
            el.set(qn("w:val"), "single")
            el.set(qn("w:sz"), "4")
            el.set(qn("w:space"), "0")
            el.set(qn("w:color"), "auto")
            borders.append(el)
    elif style == "none":
        for side in ("top", "left", "bottom", "right", "insideH", "insideV"):
            el = OxmlElement(f"w:{side}")
            el.set(qn("w:val"), "none")
            el.set(qn("w:sz"), "0")
            el.set(qn("w:space"), "0")
            el.set(qn("w:color"), "auto")
            borders.append(el)

    tblPr.append(borders)


def clear_body(doc):
    """Clear body text/tables but keep section break paragraphs and top image paragraphs/tables (logos)."""
    body = doc._element.body
    sectpr_paras = []
    logo_paras = []
    logo_tables = []

    # First pass: identify logo paragraphs (images in first 3 paragraphs)
    para_count = 0
    for child in body:
        if child.tag == qn("w:p"):
            para_count += 1
            if para_count <= 3:
                # Check if paragraph has image/drawing
                has_image = False
                for run in child.findall(qn("w:r")):
                    if run.findall(qn("w:drawing")):
                        has_image = True
                        break
                if has_image:
                    logo_paras.append(child)

    # Identify logo tables (tables with drawings in first 3 tables)
    table_count = 0
    for child in body:
        if child.tag == qn("w:tbl"):
            table_count += 1
            if table_count <= 3:
                # Check if table has drawing
                has_drawing = len(child.findall(f".//{qn('w:drawing')}")) > 0
                if has_drawing:
                    logo_tables.append(child)

    # Second pass: clear body but preserve logos and section breaks
    for child in list(body):
        if child.tag == qn("w:sectPr"):
            continue
        if child in logo_paras:
            continue  # Preserve logo paragraphs
        if child in logo_tables:
            continue  # Preserve logo tables
        if child.tag == qn("w:p"):
            pPr = child.find(qn("w:pPr"))
            if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                # Keep this paragraph (it has section break)
                # Clear text but add zero-width space
                for run in child.findall(qn("w:r")):
                    child.remove(run)
                r = OxmlElement("w:r")
                t = OxmlElement("w:t")
                t.set(qn("xml:space"), "preserve")
                t.text = "\u200b"
                r.append(t)
                child.append(r)
                sectpr_paras.append(child)
                continue
        body.remove(child)
    return sectpr_paras


def distribute_section_breaks(doc, n_breaks):
    """Insert n_breaks section breaks evenly distributed among body paragraphs."""
    if n_breaks <= 0:
        return
    body = doc._element.body
    # Count content paragraphs (exclude final sectPr)
    content_elements = [c for c in body if c.tag != qn("w:sectPr")]
    total = len(content_elements)
    if total == 0:
        return
    # Calculate interval
    interval = max(1, total // (n_breaks + 1))
    # Insert section breaks at intervals (from end to start to preserve indices)
    insert_positions = []
    for i in range(1, n_breaks + 1):
        pos = min(i * interval, total - 1)
        if pos not in insert_positions:
            insert_positions.append(pos)
    # Get final sectPr to copy its properties
    final_sectpr = body.find(qn("w:sectPr"))
    for pos in reversed(insert_positions):
        target = content_elements[pos] if pos < len(content_elements) else content_elements[-1]
        # Add sectPr to this paragraph's pPr (inline section break)
        if target.tag == qn("w:p"):
            pPr = target.find(qn("w:pPr"))
            if pPr is None:
                pPr = OxmlElement("w:pPr")
                target.insert(0, pPr)
            sp = OxmlElement("w:sectPr")
            # Copy page size and margins from final sectPr
            if final_sectpr is not None:
                for prop_tag in ("w:pgSz", "w:pgMar", "w:cols"):
                    orig = final_sectpr.find(qn(prop_tag))
                    if orig is not None:
                        import copy
                        sp.append(copy.deepcopy(orig))
            pPr.append(sp)


def insert_column_break(doc, num_cols):
    """Insert continuous section break inline (attach to last paragraph, not empty para)."""
    if CFG["columns"] <= 1:
        return
    body = doc._element.body
    final_sectpr = body.find(qn("w:sectPr"))

    # Find last content paragraph (not empty, not already has sectPr)
    last_para = None
    for child in reversed(list(body)):
        if child.tag == qn("w:sectPr"):
            continue
        if child.tag == qn("w:p"):
            pPr = child.find(qn("w:pPr"))
            if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                continue
            last_para = child
            break

    if last_para is None:
        # No content paragraph found, skip
        return

    # Attach sectPr inline to last paragraph
    pPr = last_para.find(qn("w:pPr"))
    if pPr is None:
        pPr = OxmlElement("w:pPr")
        last_para.insert(0, pPr)

    sp = OxmlElement("w:sectPr")
    # Set type=continuous
    sec_type = OxmlElement("w:type")
    sec_type.set(qn("w:val"), "continuous")
    sp.append(sec_type)
    # Copy page size and margins from final sectPr
    if final_sectpr is not None:
        for prop_tag in ("w:pgSz", "w:pgMar"):
            orig = final_sectpr.find(qn(prop_tag))
            if orig is not None:
                import copy
                sp.append(copy.deepcopy(orig))
    # Set columns
    cols_el = OxmlElement("w:cols")
    cols_el.set(qn("w:num"), str(num_cols))
    sp.append(cols_el)
    pPr.append(sp)
def remove_trailing_empty_sectpr_paras(doc):
    """Remove empty paragraphs with sectPr at the end of body by moving sectPr to previous content paragraph."""
    body = doc._element.body
    to_process = []

    # Scan backwards from end to find trailing empty sectPr paragraphs
    for child in reversed(list(body)):
        if child.tag == qn("w:sectPr"):
            # Skip final sectPr, continue scanning
            continue
        if child.tag == qn("w:p"):
            pPr = child.find(qn("w:pPr"))
            if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                # This paragraph has a section break
                # Check if it's empty (no runs with text)
                has_content = False
                for run in child.findall(qn("w:r")):
                    t_elem = run.find(qn("w:t"))
                    if t_elem is not None and t_elem.text and t_elem.text.strip():
                        has_content = True
                        break

                if not has_content:
                    # Empty paragraph with sectPr - mark for processing
                    to_process.append(child)
                else:
                    # Non-empty paragraph - stop scanning
                    break
            else:
                # Paragraph without sectPr - stop scanning
                break
        elif child.tag == qn("w:tbl"):
            # Table - stop scanning (content found)
            break

    # Process each trailing empty sectPr paragraph
    removed_count = 0
    for empty_para in to_process:
        # Extract the sectPr from this empty paragraph
        pPr = empty_para.find(qn("w:pPr"))
        sectPr = pPr.find(qn("w:sectPr")) if pPr is not None else None

        if sectPr is not None:
            # Find the last content paragraph before this empty one
            empty_index = list(body).index(empty_para)
            target_para = None

            for i in range(empty_index - 1, -1, -1):
                child = list(body)[i]
                if child.tag == qn("w:p"):
                    # Check if this paragraph has content or is also empty
                    has_content = False
                    for run in child.findall(qn("w:r")):
                        t_elem = run.find(qn("w:t"))
                        if t_elem is not None and t_elem.text and t_elem.text.strip():
                            has_content = True
                            break
                    if has_content:
                        target_para = child
                        break
                elif child.tag == qn("w:tbl"):
                    # Can't attach sectPr to table, skip this one
                    break

            if target_para is not None:
                # Move sectPr to target paragraph
                target_pPr = target_para.find(qn("w:pPr"))
                if target_pPr is None:
                    target_pPr = OxmlElement("w:pPr")
                    target_para.insert(0, target_pPr)

                # Remove sectPr from empty paragraph and add to target
                pPr.remove(sectPr)
                target_pPr.append(sectPr)

                # Now remove the empty paragraph
                body.remove(empty_para)
                removed_count += 1

    return removed_count


def _remove_trailing_empty_sectpr_paras(doc):
    """Hapus paragraf kosong bersectPr yang dijejer di ekor body,
    KECUALI yang mendefinisikan 2-column layout."""
    body = doc._element.body
    to_remove = []
    for child in reversed(list(body)):
        if child.tag == qn("w:sectPr"):
            continue
        if child.tag != qn("w:p"):
            break
        pPr = child.find(qn("w:pPr"))
        if pPr is None or pPr.find(qn("w:sectPr")) is None:
            break
        # Protect 2-column boundaries — these define the document layout
        sectpr = pPr.find(qn("w:sectPr"))
        cols = sectpr.find(qn("w:cols"))
        if cols is not None:
            num = cols.get(qn("w:num"))
            if num and num != "1":
                break
        txt = "".join(t.text or "" for t in child.findall(f".//{qn('w:t')}")).strip()
        # Treat zero-width space as empty (trailing sectPr waste)
        if not txt or txt == "\u200b":
            to_remove.append(child)
        else:
            break
    for child in to_remove:
        body.remove(child)


def add_title(doc, data):
    title = str(data.get("title", "Paper Title")).strip()
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p, before_pt=0, after_pt=6)
    run = p.add_run(title)
    set_run_font(run, CFG["font_title"], CFG["size_title"], bold=True)


def add_authors(doc, data):
    authors = data.get("authors", [])
    if not authors:
        return
    # Author names
    names = [a["name"] if isinstance(a, dict) else str(a) for a in authors]
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p, before_pt=6, after_pt=3)
    run = p.add_run(", ".join(names))
    set_run_font(run, CFG["font_title"], CFG["size_body"])

    # Affiliations
    affiliations = set()
    for a in authors:
        if isinstance(a, dict) and a.get("affiliation"):
            affiliations.add(a["affiliation"])
    if affiliations:
        p2 = doc.add_paragraph()
        p2.alignment = WD_ALIGN_PARAGRAPH.CENTER
        set_para_spacing(p2, before_pt=0, after_pt=3)
        run2 = p2.add_run("; ".join(affiliations))
        set_run_font(run2, CFG["font_title"], CFG["size_body"] - 1, italic=True)

    # Emails
    emails = [a.get("email", "") for a in authors if isinstance(a, dict) and a.get("email")]
    if emails:
        p3 = doc.add_paragraph()
        p3.alignment = WD_ALIGN_PARAGRAPH.CENTER
        set_para_spacing(p3, before_pt=0, after_pt=6)
        run3 = p3.add_run(", ".join(emails))
        set_run_font(run3, CFG["font_title"], CFG["size_body"] - 1, italic=True)


def add_abstract(doc, data):
    abstract = str(data.get("abstract", "")).strip()
    if not abstract:
        return
    # Label
    p_label = doc.add_paragraph()
    p_label.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p_label, before_pt=6, after_pt=3)
    run_label = p_label.add_run("Abstract")
    set_run_font(run_label, CFG["font_body"], CFG["size_body"], bold=True)
    # Content
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    set_para_spacing(p, before_pt=0, after_pt=6)
    run = p.add_run(abstract)
    set_run_font(run, CFG["font_body"], CFG["size_body"])


def add_keywords(doc, data):
    keywords = data.get("keywords", [])
    if not keywords:
        return
    if isinstance(keywords, list):
        kw_text = ", ".join(str(k) for k in keywords)
    else:
        kw_text = str(keywords)
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    set_para_spacing(p, before_pt=0, after_pt=6)
    run_label = p.add_run("Keywords: ")
    set_run_font(run_label, CFG["font_body"], CFG["size_body"], bold=True)
    run_kw = p.add_run(kw_text)
    set_run_font(run_kw, CFG["font_body"], CFG["size_body"], italic=True)


def add_section_heading(doc, title):
    """Add section heading - NO manual numbering (let Word handle it)."""
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.LEFT
    set_para_spacing(p, before_pt=6, after_pt=3)
    display = title.upper() if CFG["section_heading_upper"] else title
    run = p.add_run(display)
    set_run_font(run, CFG["font_heading"], CFG["size_heading1"], bold=True, color=CFG.get("heading_color"))


def add_subsection_heading(doc, title):
    """Add subsection heading - NO manual numbering."""
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.LEFT
    set_para_spacing(p, before_pt=3, after_pt=3)
    run = p.add_run(title)
    set_run_font(run, CFG["font_heading"], CFG["size_heading2"], bold=True, color=CFG.get("heading_color"))


def _clean_latex(text):
    """Strip inline LaTeX markers dari body text supaya tidak bocor ke output."""
    text = re.sub(r'\$([^$]+)\$', r'\1', text)
    text = re.sub(r'\\mathrm\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\mathbf\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\text\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\hat\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\vec\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\overline\{([^}]*)\}', r'\1', text)
    text = re.sub(r'\\sqrt\{([^}]*)\}', r'sqrt(\1)', text)
    text = re.sub(r'\\frac\{([^}]*)\}\{([^}]*)\}', r'(\1/\2)', text)
    text = re.sub(r'\\left[(\[{]', '(', text)
    text = re.sub(r'\\right[)\]}]', ')', text)
    text = re.sub(r'\\begin\{cases\}', '', text)
    text = re.sub(r'\\end\{cases\}', '', text)
    text = re.sub(r'\\approx', chr(8776), text)
    text = re.sub(r'\\times', chr(215), text)
    text = re.sub(r'\\cdot', chr(183), text)
    text = re.sub(r'\\quad', ' ', text)
    text = re.sub(r'\\qquad', '  ', text)
    text = re.sub(r'\\infty', chr(8734), text)
    text = re.sub(r'\\circ', chr(176), text)
    text = re.sub(r'\\alpha', chr(945), text)
    text = re.sub(r'\\beta', chr(946), text)
    text = re.sub(r'\\gamma', chr(947), text)
    text = re.sub(r'\\theta', chr(952), text)
    text = re.sub(r'\\lambda', chr(955), text)
    text = re.sub(r'\\sigma', chr(963), text)
    text = re.sub(r'\\omega', chr(969), text)
    text = re.sub(r'\\pi', chr(960), text)
    text = re.sub(r'\\mu', chr(956), text)
    text = re.sub(r'\\Delta', chr(916), text)
    text = re.sub(r'\\partial', chr(8706), text)
    text = re.sub(r'[_^]\{([^}]*)\}', r'\1', text)
    text = re.sub(r'_([a-zA-Z0-9])', r'\1', text)
    text = re.sub(r'\^([a-zA-Z0-9])', r'\1', text)
    text = re.sub(r'\\[a-zA-Z]+', '', text)
    text = re.sub(r'[{}]', '', text)
    return text.strip()


def add_body_text(doc, text):
    cleaned = _clean_latex(text)
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    set_para_spacing(p, before_pt=0, after_pt=0)
    if CFG["first_line_indent_tw"] > 0:
        set_para_indent(p, first_line_tw=CFG["first_line_indent_tw"])
    run = p.add_run(cleaned)
    set_run_font(run, CFG["font_body"], CFG["size_body"])


def add_figure(doc, fig_data, fig_counter):
    fig_no = str(fig_data.get("ImageNumber", fig_counter)).strip()
    title = str(fig_data.get("Title", f"Figure {fig_no}")).strip()
    prompt_hint = str(fig_data.get("Prompt", "")).strip()

    # AI prompt (red italic)
    p_img = doc.add_paragraph()
    p_img.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p_img, before_pt=3, after_pt=3)
    dyn_prompt = prompt_hint or (
        f"Buatkan gambar/diagram/ilustrasi teknis yang merepresentasikan "
        f"'{title}'. Pastikan visualnya profesional dan cocok untuk jurnal akademik."
    )
    cleaned_title = _clean_latex(title)
    cleaned_prompt = _clean_latex(dyn_prompt)
    prompt_text = f"[PROMPT UNTUK AI GAMBAR: {cleaned_title}. {cleaned_prompt}]"
    run = p_img.add_run(prompt_text)
    set_run_font(run, CFG["font_body"], CFG["size_body"], italic=True, color=(0xFF, 0x00, 0x00))

    # Caption
    p_cap = doc.add_paragraph()
    p_cap.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p_cap, before_pt=3, after_pt=6)
    run_label = p_cap.add_run(f"{CFG['fig_prefix']} {fig_no}. ")
    set_run_font(run_label, CFG["font_body"], CFG["size_caption"], bold=True)
    run_title = p_cap.add_run(_clean_latex(title))
    set_run_font(run_title, CFG["font_body"], CFG["size_caption"])


def add_table_element(doc, tbl_data, tbl_counter):
    tbl_no = str(tbl_data.get("TableNumber", tbl_counter)).strip()
    title = str(tbl_data.get("Title", f"Table {tbl_no}")).strip()
    headers = tbl_data.get("Headers", [])
    rows = tbl_data.get("Rows", [])

    # Title above table
    p_title = doc.add_paragraph()
    p_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p_title, before_pt=6, after_pt=3)
    run_label = p_title.add_run(f"{CFG['tbl_prefix']} {tbl_no}. ")
    set_run_font(run_label, CFG["font_body"], CFG["size_caption"], bold=True)
    run_title = p_title.add_run(_clean_latex(title))
    set_run_font(run_title, CFG["font_body"], CFG["size_caption"])

    if not headers and not rows:
        if CFG["columns"] > 1:
            insert_column_break(doc, CFG["columns"])
        return

    n_cols = len(headers) if headers else (len(rows[0]) if rows else 2)
    n_rows = len(rows) + (1 if headers else 0)
    table = doc.add_table(rows=n_rows, cols=n_cols)
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    set_table_borders(table, CFG["table_borders"])

    # Header row
    if headers:
        for j, h in enumerate(headers):
            if j < n_cols:
                cell = table.rows[0].cells[j]
                cell.text = ""
                p = cell.paragraphs[0]
                p.alignment = WD_ALIGN_PARAGRAPH.CENTER
                run = p.add_run(_clean_latex(str(h)))
                set_run_font(run, CFG["font_body"], CFG["size_caption"], bold=True)

    # Data rows
    start_row = 1 if headers else 0
    for i, row_data in enumerate(rows):
        if not isinstance(row_data, list):
            continue
        row_idx = start_row + i
        if row_idx >= n_rows:
            break
        for j, val in enumerate(row_data):
            if j < n_cols:
                cell = table.rows[row_idx].cells[j]
                cell.text = ""
                p = cell.paragraphs[0]
                p.alignment = WD_ALIGN_PARAGRAPH.CENTER
                run = p.add_run(_clean_latex(str(val)))
                set_run_font(run, CFG["font_body"], CFG["size_caption"])



def add_formula(doc, formula_data):
    latex = str(formula_data.get("latex", formula_data.get("Formula", ""))).strip()
    number = str(formula_data.get("FormulaNumber", "")).strip()
    if not latex:
        return
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_para_spacing(p, before_pt=3, after_pt=3)
    cleaned = _clean_latex(latex)
    display = cleaned
    if number:
        display = f"{cleaned}    ({number})"
    run = p.add_run(display)
    set_run_font(run, "Cambria Math", CFG["size_body"], italic=True)


def add_references(doc, data):
    refs_data = data.get("references", {})
    if isinstance(refs_data, dict):
        refs_list = refs_data.get("content", [])
    elif isinstance(refs_data, list):
        refs_list = refs_data
    else:
        refs_list = []

    if not refs_list:
        return

    # Heading
    add_section_heading(doc, "References")

    # Items
    for i, ref in enumerate(refs_list, 1):
        ref_text = str(ref.get("text", ref) if isinstance(ref, dict) else ref).strip()
        if not ref_text:
            continue
        p = doc.add_paragraph()
        p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
        set_para_spacing(p, before_pt=0, after_pt=0)
        set_para_indent(p, left_tw=360, hanging_tw=360)
        run = p.add_run(f"[{i}] {ref_text}")
        set_run_font(run, CFG["font_body"], CFG["size_reference"])


def process_content_items(doc, content_list, fig_counter, tbl_counter):
    """Process a list of content items (text, gambar, rumus, tabel)."""
    if not isinstance(content_list, list):
        return fig_counter, tbl_counter

    for item in content_list:
        if not isinstance(item, dict):
            continue
        kind = str(item.get("id", "")).lower()

        if kind in ("text", "paragraf", "paragraph"):
            text = str(item.get("text", item.get("Text", ""))).strip()
            if text:
                add_body_text(doc, text)

        elif kind in ("gambar", "image", "figure"):
            fig_counter += 1
            add_figure(doc, item, fig_counter)

        elif kind in ("tabel", "table"):
            tbl_counter += 1
            add_table_element(doc, item, tbl_counter)

        elif kind in ("rumus", "equation", "formula", "persamaan"):
            add_formula(doc, item)

    return fig_counter, tbl_counter


def process_section(doc, section_data, fig_counter, tbl_counter):
    """Process a section (and its subsections) recursively."""
    if not isinstance(section_data, dict):
        return fig_counter, tbl_counter

    # Section title
    title = str(section_data.get("title", section_data.get("Title", ""))).strip()
    if title:
        add_section_heading(doc, title)

    # Content items at this level
    content = section_data.get("content", section_data.get("Content", []))
    fig_counter, tbl_counter = process_content_items(doc, content, fig_counter, tbl_counter)

    # Find subsections (keys like section2a, section2b, etc.)
    for key in sorted(section_data.keys()):
        if key in ("title", "Title", "content", "Content", "id"):
            continue
        val = section_data[key]
        if isinstance(val, dict) and ("title" in val or "Title" in val or "content" in val or "Content" in val):
            # This is a subsection
            sub_title = str(val.get("title", val.get("Title", ""))).strip()
            if sub_title:
                add_subsection_heading(doc, sub_title)
            sub_content = val.get("content", val.get("Content", []))
            fig_counter, tbl_counter = process_content_items(doc, sub_content, fig_counter, tbl_counter)

            # Check for sub-subsections
            for subkey in sorted(val.keys()):
                if subkey in ("title", "Title", "content", "Content", "id"):
                    continue
                subval = val[subkey]
                if isinstance(subval, dict) and ("title" in subval or "Title" in subval or "content" in subval or "Content" in subval):
                    ssub_title = str(subval.get("title", subval.get("Title", ""))).strip()
                    if ssub_title:
                        add_subsection_heading(doc, ssub_title)
                    ssub_content = subval.get("content", subval.get("Content", []))
                    fig_counter, tbl_counter = process_content_items(doc, ssub_content, fig_counter, tbl_counter)

    return fig_counter, tbl_counter


def _measure_section_weights(doc):
    """Hitung jumlah elemen konten (paragraf non-sectPr + tabel) di tiap segmen
    antara inline sectPr-paragraph berurutan. Dipakai untuk distribusi body
    PROPORSIONAL supaya layout multi-kolom AEJ (body 2-kolom + referensi
    1-kolom) terjaga. Diukur SEBELUM clear_body (doc masih berisi original).

    Return list selaras dengan boundaries = sectpr_paras[1:] + final body sectPr:
    elemen ke-i = jumlah konten di section yang berakhir pada boundary ke-i.
    """
    body = doc._element.body
    seg_counts = []
    current = 0
    seen_first = False
    for child in body.iterchildren():
        if child.tag == qn("w:sectPr"):
            continue  # final body sectPr (level body), lewati
        if child.tag == qn("w:p"):
            pPr = child.find(qn("w:pPr"))
            if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                # Boundary tercapai: tutup segmen berjalan.
                seg_counts.append(current)
                current = 0
                seen_first = True
                continue
        # Elemen konten (paragraf tanpa sectPr, atau tabel).
        if seen_first:
            current += 1
    seg_counts.append(current)  # segmen ekor (konten setelah sectPr-para terakhir)
    # seg_counts[0] = area judul (sebelum sectPr-para pertama) -> dibuang.
    return seg_counts[1:] if len(seg_counts) > 1 else []




def _inject_masthead_content(doc, data):
    """Inject title, authors, abstract ke masthead table cells.
    Mengganti teks di runs yg sudah ada (preserve formatting)."""
    body = doc._element.body
    masthead = None
    for child in list(body):
        if child.tag != qn("w:tbl"):
            continue
        if child.findall(f".//{qn('w:drawing')}"):
            masthead = child
            break
    if masthead is None:
        return

    rows = masthead.findall(qn("w:tr"))
    if len(rows) < 6:
        return

    title = _clean_latex(str(data.get("title", "")).strip())
    abstract = _clean_latex(str(data.get("abstract", "")).strip())

    # Authors
    authors = data.get("authors", [])
    author_names = []
    affiliations = set()
    for a in authors:
        name = a["name"] if isinstance(a, dict) else str(a)
        author_names.append(name)
        if isinstance(a, dict) and a.get("affiliation"):
            affiliations.add(a["affiliation"])
    author_str = ", ".join(author_names)
    affil_str = "; ".join(affiliations) if affiliations else ""

    # Keywords
    keywords = data.get("keywords", [])
    if isinstance(keywords, list):
        kw_str = _clean_latex(", ".join(keywords))
    else:
        kw_str = _clean_latex(str(keywords))

    # Inject ke Row 3 Cell 0 (title + authors in merged cell)
    # Cell has multiple runs: title, line break, authors, etc.
    # Ganti teks run pertama dengan judul, run kedua dengan authors
    try:
        tc = rows[3].findall(qn("w:tc"))[0]
        all_runs = tc.findall(f".//{qn('w:r')}")
    except IndexError:
        all_runs = []

    if all_runs:
        # Find runs with title text (ubahn jadi judul asli)
        title_runs = []
        author_runs = []
        author_runs_start = False
        for r in all_runs:
            t_els = r.findall(qn("w:t"))
            combined = "".join(t.text or "" for t in t_els)
            if not author_runs_start and "Azizul" in combined or "Ungku" in combined:
                author_runs_start = True
            if not author_runs_start:
                title_runs.append(r)
            else:
                author_runs.append(r)

        # Ganti teks di title runs
        if title_runs:
            remaining = title
            for r in title_runs:
                t_els = r.findall(qn("w:t"))
                if not t_els:
                    continue
                # Ambil total kapasitas karakter dari runs ini
                old_len = sum(len(t.text or "") for t in t_els)
                if old_len > 0 and remaining:
                    # Replace first t element text
                    t_els[0].text = remaining[:old_len]
                    for t in t_els[1:]:
                        t.text = ""
                    remaining = remaining[old_len:]
                else:
                    for t in t_els:
                        t.text = ""

        # Ganti teks di author runs
        if author_runs:
            remaining_auth = author_str
            if affil_str:
                remaining_auth += ", " + affil_str
            for r in author_runs:
                t_els = r.findall(qn("w:t"))
                if not t_els:
                    continue
                old_len = sum(len(t.text or "") for t in t_els)
                if old_len > 0 and remaining_auth:
                    t_els[0].text = remaining_auth[:old_len]
                    for t in t_els[1:]:
                        t.text = ""
                    remaining_auth = remaining_auth[old_len:]
                else:
                    for t in t_els:
                        t.text = ""

    # Inject abstract ke Row 5 Cell 1
    try:
        tc_abs = rows[5].findall(qn("w:tc"))[1]
        abs_runs = tc_abs.findall(f".//{qn('w:r')}")
    except IndexError:
        abs_runs = []

    if abs_runs and abstract:
        remaining = abstract
        for r in abs_runs:
            t_els = r.findall(qn("w:t"))
            if not t_els:
                continue
            old_len = sum(len(t.text or "") for t in t_els)
            if old_len > 0 and remaining:
                t_els[0].text = remaining[:old_len]
                for t in t_els[1:]:
                    t.text = ""
                remaining = remaining[old_len:]
            else:
                for t in t_els:
                    t.text = ""


def generate():
    data = load_json()

    shutil.copy2(str(TEMPLATE_DOCX), str(OUTPUT_DOCX))
    doc = Document(str(OUTPUT_DOCX))

    # Ukur bobot konten tiap section ORIGINAL sebelum clear_body (untuk distribusi
    # body proporsional yang mempertahankan layout multi-kolom AEJ).
    section_weights = _measure_section_weights(doc)

    # Clear body but keep section break paragraphs in place
    sectpr_paras = clear_body(doc)
    body = doc._element.body

    # Inject title, authors, abstract ke masthead cells
    _inject_masthead_content(doc, data)

    # Find insertion point: before first sectPr paragraph (or final sectPr)
    if sectpr_paras:
        insert_before = sectpr_paras[0]
    else:
        insert_before = body.find(qn("w:sectPr"))

    # Keywords dan abstract di body (sebagai fallback)
    # Title+author+abstract juga di-inject ke masthead cells di atas
    add_abstract(doc, data)
    add_keywords(doc, data)

    # Move title block paragraphs to before first section break
    if insert_before is not None:
        new_paras = []
        for child in list(body):
            if child.tag == qn("w:sectPr"):
                continue
            if child.tag == qn("w:p"):
                pPr = child.find(qn("w:pPr"))
                if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                    continue
            if list(body).index(child) > list(body).index(insert_before):
                new_paras.append(child)
        for p in new_paras:
            body.remove(p)
            body.insert(list(body).index(insert_before), p)

    # Snapshot existing body children so new body content can be isolated later
    pre_body_ids = {id(c) for c in body}

    # Generate body content (flat stream, appended at end of body)
    fig_counter = 0
    tbl_counter = 0
    for i in range(1, 30):
        key = f"section{i}"
        if key in data:
            fig_counter, tbl_counter = process_section(doc, data[key], fig_counter, tbl_counter)

    # References
    add_references(doc, data)

    # Collect the newly generated body elements in order, excluding the
    # section-break marker paragraphs and the final sectPr.
    #
    # PENTING: lewati juga elemen ber-DRAWING (tabel masthead / paragraf logo
    # yang dipreservasi clear_body). Body yang di-generate TIDAK pernah memuat
    # drawing (gambar = paragraf prompt teks merah), jadi setiap drawing pasti
    # logo/masthead milik segment 1 full-width. Memindahnya ke zona 2-kolom
    # membuat banner ASEAN Engineering Journal ter-render gepeng 2-kolom (rusak
    # visual). Dengan skip ini, masthead tetap di atas (segment 1).
    body_elements = []
    for child in list(body):
        if id(child) in pre_body_ids:
            continue
        if child.tag == qn("w:sectPr"):
            continue
        if child.findall(f".//{qn('w:drawing')}"):
            continue  # logo/masthead -> tetap di segment 1
        if child.tag == qn("w:p"):
            pPr = child.find(qn("w:pPr"))
            if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
                continue
        body_elements.append(child)

    # LAYOUT AEJ (identik visual original): masthead + blok judul tetap full-width
    # (segment 1). SELURUH body + referensi mengalir sebagai SATU blok kontigu di
    # section 2-KOLOM PERTAMA, persis seperti paper jurnal 2-kolom normal.
    #
    # Boundary sisanya (segment 1-kolom #3/#6/#7) adalah BOILERPLATE template AEJ
    # (tabel placeholder kosong + form Copyright Transfer) yang TIDAK di-generate
    # untuk paper user -> dibiarkan KOSONG. Semuanya CONTINUOUS section break,
    # jadi ekor kosong TIDAK menghasilkan halaman kosong dan tak terlihat.
    #
    # KENAPA TIDAK didistribusi merata/proporsional antar boundary: section 1-kolom
    # AEJ diperuntukkan boilerplate, bukan body. Menyebar body ke sana membuat
    # REFERENSI & gambar ter-render 1-kolom (rusak visual) padahal seharusnya
    # 2-kolom. Maka body ditaruh utuh di zona 2-kolom.
    final_sectpr = body.find(qn("w:sectPr"))

    def _boundary_cols(p_el):
        """Jumlah kolom (w:cols/@w:num) pada inline sectPr paragraf boundary."""
        pPr = p_el.find(qn("w:pPr"))
        sp = pPr.find(qn("w:sectPr")) if pPr is not None else None
        if sp is None:
            return 1
        cols = sp.find(qn("w:cols"))
        if cols is None:
            return 1
        num = cols.get(qn("w:num"))
        try:
            return int(num) if num else 1
        except (ValueError, TypeError):
            return 1

    # Target = boundary PERTAMA (setelah boundary masthead/judul) yang section-nya
    # multi-kolom. Body disisipkan SEBELUM boundary itu -> jatuh DI DALAM section
    # 2-kolom tsb. Fallback berurutan: boundary body pertama, lalu final sectPr.
    target_boundary = None
    for sp_para in sectpr_paras[1:]:
        if _boundary_cols(sp_para) >= 2:
            target_boundary = sp_para
            break
    if target_boundary is None:
        if len(sectpr_paras) > 1:
            target_boundary = sectpr_paras[1]
        elif sectpr_paras:
            target_boundary = sectpr_paras[0]
        else:
            target_boundary = final_sectpr

    if body_elements:
        anchor = target_boundary if target_boundary is not None else final_sectpr
        if anchor is not None:
            # Fixed anchor index — all body elements go BEFORE anchor
            anchor_idx = list(body).index(anchor)
            body_elements_set = {id(el) for el in body_elements}
            # Build desired order: keep non-body elements, insert body_elements before anchor
            keep_order = [c for c in list(body) if id(c) not in body_elements_set]
            anchor_found = False
            new_order = []
            for c in keep_order:
                if c is anchor or c == anchor:
                    new_order.extend(body_elements)
                    anchor_found = True
                new_order.append(c)
            if not anchor_found:
                new_order.extend(body_elements)
            # Assert body has same elements (just reordered)
            # Rebuild: remove all, re-add in new order
            for c in list(body):
                body.remove(c)
            for c in new_order:
                body.append(c)

    # Remove trailing empty sectPr paragraphs (cleanup)
    _remove_trailing_empty_sectpr_paras(doc)

    # Save
    doc.save(str(OUTPUT_DOCX))
    print(f"Generated: {OUTPUT_DOCX}")
    print("[VERIFY] OK")
    return str(OUTPUT_DOCX)


if __name__ == "__main__":
    generate()
