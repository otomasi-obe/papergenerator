<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>VIOLA AI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="VIOLA AI Assistant" />
  <Description DefaultValue="VIOLA AI Assistant for Word - Chat, Generate, and Edit Documents with AI" />
  <IconUrl DefaultValue="https://ai.otomasi.app/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://ai.otomasi.app/icon-80.png" />
  <SupportUrl DefaultValue="https://ai.otomasi.app/support" />
  <AppDomains>
    <AppDomain>https://ai.otomasi.app</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="{BASE_URL}/api/word-addon/taskpane/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.1" />
    </Sets>
  </Requirements>
</OfficeApp>
