# PaperGenerator — environment variables (backend/.env)
# Copy ke backend/.env dan isi dengan nilai asli.
# Ini override dari root .env. JANGAN commit .env asli.
#
# Var kritis (wajib):
DATABASE_URL=postgresql://papergenerator@/papergenerator
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=changeme-64-char-random-string
JWT_SECRET_KEY=changeme-another-64-char-random-string

# Var lainnya (lihat ../.env.example untuk daftar lengkap)
FLASK_ENV=production
FLASK_DEBUG=false