{
  "annotations": { "list": [] },
  "title": "PaperFull — Rate Limit Monitoring",
  "uid": "paperfull-rate-limits",
  "schemaVersion": 39,
  "tags": ["paperfull", "rate-limiting", "security"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "title": "Rate Limit Breaches Over Time",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_breaches_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Total Breach Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1.0}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_breaches_total[5m]))"
        }
      ]
    },
    {
      "title": "Breach Percentage",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_breaches_total[5m])) / clamp_min(sum(rate(rate_limit_requests_total[5m])), 0.001)"
        }
      ]
    },
    {
      "title": "Top 10 Rate-Limited Endpoints",
      "type": "bargauge",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.5}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(rate_limit_breaches_total[5m])) by (endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Request Status Distribution",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Allowed vs Blocked Requests",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_requests_total{status=\"allowed\"}[5m]))",
          "legendFormat": "Allowed"
        },
        {
          "expr": "sum(rate(rate_limit_requests_total{status=\"blocked\"}[5m]))",
          "legendFormat": "Blocked"
        }
      ]
    },
    {
      "title": "Breaches by Limit Type",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_breaches_total[5m])) by (limit_type)",
          "legendFormat": "{{limit_type}}"
        }
      ]
    },
    {
      "title": "Rate Limit Events (Last 24h)",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Breaches", "desc": true}]
      },
      "targets": [
        {
          "expr": "sum(increase(rate_limit_breaches_total[24h])) by (endpoint, limit_type)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "endpoint": "Endpoint",
              "limit_type": "Limit Type",
              "Value": "Breaches (24h)"
            }
          }
        }
      ]
    }
  ]
}
